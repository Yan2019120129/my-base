# 后台入口地址（生产环境示例）
VITE_ADMIN_URL=https://020200.xyz/admin

# 前台站点基础地址，不带结尾斜杠
VITE_SITE_URL=https://020200.xyz

# 当前环境标识：local | dev | test | prod
VITE_APP_ENV=prod

# 后台 API 根地址，包含 /admin；业务接口路径从该地址之后拼接
VITE_API_BASE_URL=https://020200.xyz/admin

# 后台登录地址
VITE_LOGIN_URL=https://020200.xyz/admin/login

# tus 断点续传地址，必须以斜杠结尾
VITE_TUS_ENDPOINT=https://020200.xyz/admin/files/tus/

# 文件分享地址前缀，分享 token 和 /download 由前端拼接
VITE_SHARE_BASE_URL=https://020200.xyz/shares/

# 请求超时时间（毫秒）
VITE_REQUEST_TIMEOUT=15000
